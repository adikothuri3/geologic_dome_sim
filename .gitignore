notes/.obsidian/workspace.json
notes/.obsidian/workspace-mobile.json
__pycache__/
.venv/

# Symlink/junction to the Menagerie clone (created by install step A4)
sim/menagerie

# Training run outputs: checkpoints and progress logs. The distilled result of every run
# lives in notes/experiments.md, which IS tracked.
runs/

# Phase 1 render outputs. The MP4 is regenerable (`python sim/pose_and_render.py`) and too
# big for git; the contact sheets are lab-notebook evidence and are kept.
*.mp4
reports/check_render.png

# `.claude/skills/mujoco` is a junction to `.agents/skills/mujoco` (the real, tracked copy).
# Windows git follows the junction and commits a duplicate; WSL git sees a symlink and
# reports all ten files deleted -- which made every WSL-side tree look dirty and would block
# train_g1.py, whose clean-tree gate keeps experiments.md rows reproducible.
.claude/skills/mujoco
