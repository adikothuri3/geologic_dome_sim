<!--
  G1 joystick scene with full-body collision.

  Identical to Playground's scene_mjx_feetonly_flat_terrain.xml except that it includes
  g1_full_collision.xml (generated by scripts/make_full_collision_xml.py) instead of
  g1_mjx_feetonly.xml. Everything else -- floor, visuals, sensors, keyframes -- is unchanged,
  so the only difference from the feet-only baseline is which parts of the robot can touch
  the world.

  No <contact><pair> block is needed here. The generated body xml sets contype/conaffinity on
  the `collision` class, so MuJoCo's broadphase finds contacts for every collidable geom,
  and MuJoCo's default parent-child filtering keeps adjacent links from fighting each other.
  A side effect worth noting: the left_foot~right_shin and right_foot~left_shin contact
  sensors in sensor.xml -- which _get_termination() reads to catch leg crossing, and which
  could never fire upstream because their <pair> entries were commented out -- now work.

  This file must sit in Playground's own xmls/ directory: <include> and mesh paths resolve
  relative to the top-level scene file. scripts/train_g1.py --full-collision syncs it and the
  generated body xml there; the copies in sim/ are the source of truth.
-->
<mujoco model="g1 scene full collision">
  <include file="g1_full_collision.xml"/>

  <statistic center="0 0 0.7" extent="1.2" meansize="0.04"/>

  <visual>
    <headlight diffuse=".8 .8 .8" ambient=".2 .2 .2" specular="1 1 1"/>
    <rgba force="1 0 0 1"/>
    <global azimuth="140" elevation="-20"/>
    <map force="0.01"/>
    <scale forcewidth="0.3" contactwidth="0.5" contactheight="0.2"/>
    <quality shadowsize="8192"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="1 1 1" rgb2="1 1 1" width="800" height="800"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="1 1 1" rgb2="1 1 1"
      markrgb="0 0 0" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0"/>
  </asset>

  <worldbody>
    <geom name="floor" size="0 0 0.01" type="plane" material="groundplane"/>
  </worldbody>

  <include file="sensor.xml"/>

  <keyframe>
    <key name="home"
      qpos="
      0 0 0.785
      1 0 0 0
      -0.1 0 0 0.3 -0.2 0
      -0.1 0 0 0.3 -0.2 0
      0 0 0
      0.2 0.2 0 1.28 0 0 0
      0.2 -0.2 0 1.28 0 0 0
      "
      ctrl="
      -0.1 0 0 0.3 -0.2 0
      -0.1 0 0 0.3 -0.2 0
      0 0 0
      0.2 0.2 0 1.28 0 0 0
      0.2 -0.2 0 1.28 0 0 0
      "/>
    <key name="knees_bent"
      qpos="
      0 0 0.755
      1 0 0 0
      -0.312 0 0 0.669 -0.363 0
      -0.312 0 0 0.669 -0.363 0
      0 0 0.073
      0.2 0.2 0 0.6 0 0 0
      0.2 -0.2 0 0.6 0 0 0
      "
      ctrl="
      -0.312 0 0 0.669 -0.363 0
      -0.312 0 0 0.669 -0.363 0
      0 0 0.073
      0.2 0.2 0 0.6 0 0 0
      0.2 -0.2 0 0.6 0 0 0
    "/>
  </keyframe>
</mujoco>
